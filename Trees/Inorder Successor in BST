    int inOrderSuccessor(Node *root, Node *k) {
         int ans=-1;
         while(root != NULL){
             if(root->data > k->data){
                 ans = root->data;
                 root = root->left;
             }else{
                 root = root->right;
             }
         }
         return ans;
    }
